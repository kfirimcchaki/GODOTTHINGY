# --- Server ---------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Absolute URL this site is served from. Used to build OAuth redirects and
# share links. Leave blank to derive it from the incoming request.
PUBLIC_URL=
SITE_NAME=NT Scripting

# --- Auth -----------------------------------------------------------------
# AUTH_MODE=mock  -> use the built-in development identity provider that ships
#                    with this repo (works out of the box, no credentials).
# AUTH_MODE=connect -> use the real "Null's Connect" OAuth provider.
# AUTH_MODE=auto  -> use connect when CONNECT_CLIENT_ID is set, else mock.
AUTH_MODE=auto

# Real Null's Connect OAuth application credentials.
CONNECT_CLIENT_ID=
CONNECT_CLIENT_SECRET=
CONNECT_AUTHORIZE_URL=https://connect.nulls.gg/oauth/authorize
CONNECT_TOKEN_URL=https://connect.nulls.gg/oauth/token
CONNECT_USERINFO_URL=https://connect.nulls.gg/oauth/userinfo
CONNECT_SCOPE=identify
CONNECT_REDIRECT_URI=

# Cookie / session
SESSION_COOKIE=nt_session
SESSION_SECRET=change-me-in-production
SESSION_TTL_HOURS=720

# --- Behaviour ------------------------------------------------------------
# When true, executing/publishing a script to a friendly battle requires the
# caller to hold beta access. Mirrors the live service, where non-beta users
# receive 404 {"error":"Script not found"} from /api/scripts/:id/share.
BETA_REQUIRED=true
MAX_CODE_BYTES=524288
MAX_EVENTS_PER_SECOND=20
